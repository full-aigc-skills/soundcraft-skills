{
  "schema": "craft-scenario-playbooks/v1",
  "application": "soundcraft",
  "id": "audio-delivery",
  "execution": "COMMAND_MAPPED_NOT_SCENE_ACCEPTED",
  "steps": [
    {
      "purpose": "检查会话长度与媒体",
      "command": "session.inspect",
      "params": {
        "detail": "summary"
      }
    },
    {
      "purpose": "导出指定范围母版",
      "command": "file.bounce_mix",
      "params": {
        "path": "output/master.wav",
        "format": "wav",
        "bit_depth": "24",
        "normalize": false
      }
    },
    {
      "purpose": "导出可审阅工程结构说明",
      "command": "file.export_session_text",
      "params": {
        "path": "output/session.txt"
      }
    }
  ],
  "check": "用独立info检查采样率、声道、时长，再播放首尾和关键段。",
  "boundary": "采样率转换使用CLI convert --rate真实参数；不要只改文件后缀或多次有损转码。",
  "templateOnly": true,
  "argumentPolicy": "示例参数必须按当前输入、选择和实际返回ID替换；$变量先解析，数组变量整字段替换，不能将本文件直接当原生CLI脚本执行。"
}
